{
  "name": "wot-server-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --config vite.config.ts",
    "dev:server": "vp dev --config vite.config.ts --mode server",
    "build": "vp build --config vite.config.ts",
    "check": "tsc --noEmit && cd ../../../../.. && vp fmt --check 'src/**/*.{ts,tsx}' package.json src/server/src/infrastructure/web/index.html src/server/src/infrastructure/web/package.json src/server/src/infrastructure/web/tsconfig.json && vp lint --config src/server/src/infrastructure/web/vite.config.ts src --react-plugin --deny-warnings",
    "format": "cd ../../../../.. && vp fmt 'src/**/*.{ts,tsx}' package.json src/server/src/infrastructure/web/index.html src/server/src/infrastructure/web/package.json src/server/src/infrastructure/web/tsconfig.json",
    "test": "vp test --config vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/otlp-transformer": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "react": "^19.3.1",
    "react-admin": "^5.15.6",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
