ContextMap Server {
  type = SYSTEM_LANDSCAPE
  state = AS_IS
  contains GameClient, ResourceExtraction, BinaryMapping, Accounts, Social, PlayerSessions, Battles, PlayerAdministration, SharedKernel, Platform
  SharedKernel [U] -> [D] PlayerAdministration {
    implementationTechnology = "Shared Rust AccountId validates parsed HTTP path identifiers"
  }
  SharedKernel [U] -> [D] PlayerSessions {
    implementationTechnology = "Shared Rust AccountId validates parsed XMPP account identifiers"
  }
  SharedKernel [U] -> [D] Social {
    implementationTechnology = "Shared Rust AccountId validates participants before Social enforces its distinct-account rule"
  }
  SharedKernel [U] -> [D] Accounts {
    implementationTechnology = "VehiclePerformance represents catalog speed, traverse, gun limits, shell ranges and reload rules."
  }
  SharedKernel [U] -> [D] Battles {
    implementationTechnology = "VehiclePerformance supplies the equipped vehicle limits, shell ranges and reload rules used by the simulation."
  }
  Platform [U] -> [D] Accounts {
    implementationTechnology = "Common client-format codecs and PostgreSQL span adapter"
  }
  Platform [U] -> [D] PlayerSessions {
    implementationTechnology = "Common Mercury transport and client-format codecs, bounded HTTP serving, blocking-work span propagation, and browser HTTP tracing and theme"
  }
  Platform [U] -> [D] Battles {
    implementationTechnology = "Shared BaseApp transport, script dispatch, and client-format codecs"
  }
  Platform [U] -> [D] PlayerAdministration {
    implementationTechnology = "Bounded HTTP serving for the admin API, with shared TypeScript HTTP tracing and theme for the dashboard"
  }
  Platform [U] -> [D] Social {
    implementationTechnology = "Common PostgreSQL span adapter"
  }
  GameClient [U] -> [D,ACL] BinaryMapping {
    implementationTechnology = "Read-only AMD64 PE; evidence-bearing offline investigation models"
  }
  GameClient [U] -> [D,ACL] ResourceExtraction {
    implementationTechnology = "Offline read-only indexing of installed packages, loose resources and version.xml source provenance"
  }
  ResourceExtraction [U,PL] -> [D,ACL] Accounts {
    implementationTechnology = "Versioned resource bundle containing garage definitions, camouflage price groups, regular tech trees and vehicle labels"
  }
  ResourceExtraction [U,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Versioned resource bundle containing script definitions and component class presence for Mercury dispatch"
  }
  GameClient [U] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Mercury UDP login, handoff, session replacement notices, garage, shared Training Room RPCs, invitations, BW_CHAT2 room messages and garage-to-arena handoff; session-authorized Store page and API on the shared listener with the configured host in the browser allowlist"
  }
  ResourceExtraction [U,PL] -> [D,ACL] Battles {
    implementationTechnology = "Resource bundle with arena definitions, geometry, terrain height tiles and battle entity schemas"
  }
  GameClient [U] -> [D,ACL] Battles {
    implementationTechnology = "Native Avatar and Vehicle control methods, arena lifecycle events and entity replication over Mercury"
  }
  Battles [U,OHS,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Map and active arena count queries, battle launch with an assigned roster, equipped loadouts with outfits and vehicle performance, viewer customization preferences, and participant lifecycle for garage handoff and scheduled return after the outcome"
  }
  Accounts [U,OHS,PL] -> [D,ACL] PlayerAdministration {
    implementationTechnology = "PlayerAccess API for identity listing, registration, provisioning, roles and web sessions, plus garage inspection and grant catalog projections"
  }
  PlayerSessions [U,OHS,PL] -> [D,ACL] PlayerAdministration {
    implementationTechnology = "Bounded PlayerGrants and StoreRequests APIs coordinate dashboard requests with garage writes. The embedded Store web entry point accepts the dashboard transport."
  }
  Accounts [U,OHS,PL] -> [D,ACL] Social {
    implementationTechnology = "Published PlayerDirectory operations resolve account IDs and display names in the Accounts schema. Social persists scalar IDs in its own schema."
  }
  Social [U,OHS,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Published contacts/search and durable private message APIs adapted to native XMPP, game-issued chat admission, history and legacy BW/BW_CHAT2 RPCs"
  }
  Accounts [U,OHS,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Published authentication, opaque account view, garage and equipped vehicle projections with catalog-defined locked outfits and module-derived movement and gun performance for battle, and revision-checked commands. Sessions orders commands and delivers committed results."
  }
}
BoundedContext GameClient {
  domainVisionStatement = "External versioned World of Tanks executable and resources supply compatibility evidence and garage definitions."
}
BoundedContext ResourceExtraction {
  domainVisionStatement = "Select the installed definitions and component class presence needed by the server and publish a standalone runtime resource bundle."
}
BoundedContext BinaryMapping {
  domainVisionStatement = "Recover supported native type and network framing metadata, retain evidence and unknowns, and emit offline Rust declarations and JSON mappings."
}
BoundedContext Accounts {
  domainVisionStatement = "Own durable identity, password hashes, player roles, dashboard sessions, balances, vehicle ownership, integer preferences, tank/module research, vehicle purchases and sales, installed modules, mounted equipment, consumables and directives, loaded ammunition, shared depot stock and sales, cosmetic ownership and seasonal and common outfits, crew rosters and training, Premium Account expiry, and revisions in PostgreSQL; project snapshots into versioned garage caches."
}
BoundedContext PlayerSessions {
  domainVisionStatement = "Own player admission, expiring handoff tickets, session lifecycle, Training Room membership, invitations, room text chat, garage-to-arena handoff, Store browser access and delivery of committed garage and chat updates and Premium Account expiry notifications."
}

BoundedContext Battles {
  domainVisionStatement = "Own live arenas, battle IDs, participants, round phases, map and terrain use, vehicle simulation, combat resolution and native battle state replication."
}

BoundedContext Social {
  domainVisionStatement = "Own persistent directed friends and ignored contacts, bounded durable private conversations and retained offline history, legacy window subscriptions, and validated nickname searches over the account directory."
}

BoundedContext PlayerAdministration {
  domainVisionStatement = "Serve player registration, web sign-in, a personal garage view and dashboard Store access, and authorize administrators to provision players, manage roles, inspect garages and grant currency, vehicles, cosmetics, crew books, Improved Equipment, Bounty Equipment or Experimental Equipment."
}

BoundedContext SharedKernel {
  domainVisionStatement = "Maintain the shared meaning and validity rule of a local player account identifier and the performance definitions for an equipped battle vehicle."
}

BoundedContext Platform {
  domainVisionStatement = "Supply reusable Mercury transport, tracing adapters and client-format codecs independently of the server's domain models."
}
