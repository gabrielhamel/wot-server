ContextMap Server {
  type = SYSTEM_LANDSCAPE
  state = AS_IS
  contains GameClient, ResourceExtraction, BinaryMapping, Accounts, Social, PlayerSessions, Battles, PlayerAdministration, Store, TrainingRooms, SharedKernel, Platform
  SharedKernel [U] -> [D] PlayerAdministration {
    implementationTechnology = "Shared Rust AccountId validates parsed HTTP path identifiers"
  }
  SharedKernel [U] -> [D] PlayerSessions {
    implementationTechnology = "Shared Rust AccountId validates parsed XMPP account identifiers"
  }
  SharedKernel [U] -> [D] Social {
    implementationTechnology = "Shared Rust AccountId validates participants before Social enforces its distinct-account rule"
  }
  SharedKernel [U] -> [D] Accounts {
    implementationTechnology = "VehiclePerformance represents loadout-adjusted mobility, gun limits, shell ballistics, explosive and stun definitions, armor meshes with optional engine compartment anchors, device health, reload rules and base spotting inputs. BattleOutfits holds the encoded garage appearance for each arena season."
  }
  SharedKernel [U] -> [D] Battles {
    implementationTechnology = "VehiclePerformance supplies the effective mobility profile, shell ballistics, explosive and stun definitions, armor meshes with optional engine compartment anchors, device health, reload rules and base spotting inputs used by the simulation. ArenaSeason and BattleOutfits determine the outfit replicated to each client."
  }
  Platform [U] -> [D] Accounts {
    implementationTechnology = "Common client-format codecs and PostgreSQL span adapter"
  }
  Platform [U] -> [D] PlayerSessions {
    implementationTechnology = "Common Mercury transport and client-format codecs, with blocking-work span propagation"
  }
  Platform [U] -> [D] Battles {
    implementationTechnology = "Script dispatch and client-format codecs; the local arena delivery adapter uses the shared BaseApp"
  }
  Platform [U] -> [D] PlayerAdministration {
    implementationTechnology = "Bounded HTTP serving for the admin API, with shared TypeScript HTTP tracing and theme for the dashboard"
  }
  Platform [U] -> [D] Social {
    implementationTechnology = "Common PostgreSQL span adapter"
  }
  Platform [U] -> [D] ResourceExtraction {
    implementationTechnology = "Packed XML codec reads client destruction definitions"
  }
  GameClient [U] -> [D,ACL] BinaryMapping {
    implementationTechnology = "Read-only AMD64 PE; evidence-bearing offline investigation models"
  }
  GameClient [U] -> [D,ACL] ResourceExtraction {
    implementationTechnology = "Offline read-only indexing of installed packages, loose resources and version.xml source provenance"
  }
  ResourceExtraction [U,PL] -> [D,ACL] Accounts {
    implementationTechnology = "Versioned resource bundle containing garage definitions, camouflage price groups, regular tech trees, vehicle labels, vehicle contact bounds and material-tagged armor meshes"
  }
  ResourceExtraction [U,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Versioned resource bundle containing script definitions and component class presence for Mercury dispatch"
  }
  GameClient [U] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Mercury UDP login, handoff, session replacement notices, garage, shared Training Room RPCs, invitations, BW_CHAT2 room messages and garage-to-arena handoff; native Store token and configured host in the browser allowlist"
  }
  ResourceExtraction [U,PL] -> [D,ACL] Battles {
    implementationTechnology = "Resource bundle with arena definitions, terrain and scenery collision geometry, native destructible IDs, fragment dependencies, SpeedTree contacts and battle entity schemas"
  }
  GameClient [U] -> [D,ACL] Battles {
    implementationTechnology = "Native Avatar and Vehicle control methods, arena lifecycle events and replication of vehicles and scenery destruction over Mercury"
  }
  Battles [U,OHS,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Battles Rust library contract for localized map options, battle parameter defaults and validation, and active arena count queries, separate bounded in-process queues for arena preparation and live simulation, checked activation with an assigned roster and gateway-assigned arena entity IDs, equipped loadouts with seasonal garage outfits, shell ballistics and armor geometry, stationary dummy participants, viewer customization preferences, typed Avatar and vehicle commands sent on a bounded in-process queue to the arena tick worker, and queued participant updates and garage returns delivered through BaseApp"
  }
  Accounts [U,OHS,PL] -> [D,ACL] PlayerAdministration {
    implementationTechnology = "Accounts Rust library PlayerAccess API for identity listing, registration, provisioning, roles and web sessions, plus garage inspection and grant catalog projections for vehicles, cosmetics, crew items, recruit groups with country options, and equipment, and vehicle-specific equipment, consumables, crew seats and perks, stock and equipped modules, hit points and ammunition options for owned, custom player and dummy loadouts"
  }
  PlayerSessions [U,OHS,PL] -> [D,ACL] PlayerAdministration {
    implementationTechnology = "PlayerGrants coordinates dashboard grants with garage writes. TrainingBattleLaunches publishes ready garage players, maps and battle parameter definitions and hands selected sessions to the prepared arena."
  }
  Platform [U] -> [D] Store {
    implementationTechnology = "Shared HTTP tracing, W3C parent extraction and browser presentation primitives."
  }
  Accounts [U,OHS,PL] -> [D,ACL] Store {
    implementationTechnology = "Garage publishes an opaque purchasable offer, account availability and stock projections. Dashboard catalog reads use an Accounts snapshot without entering the gateway."
  }
  PlayerSessions [U,OHS,PL] -> [D,ACL] Store {
    implementationTechnology = "GarageStoreAccess verifies live Store tokens and coordinates fulfillment with pending garage writes and account-cache delivery."
  }
  Store [U,OHS,PL] -> [D,ACL] PlayerAdministration {
    implementationTechnology = "Dashboard-authenticated Store routes and embedded Store browser entry point accepting the dashboard transport."
  }
  TrainingRooms [U,OHS,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "In-process room registry and rules for membership, invitations, roster assignment and team confirmation. Player Sessions adapts native requests and carries delivery identifiers."
  }
  Accounts [U,OHS,PL] -> [D,ACL] Social {
    implementationTechnology = "Accounts Rust library PlayerDirectory operations resolve account IDs and display names in the Accounts schema. Social persists scalar IDs in its own schema."
  }
  Social [U,OHS,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Social Rust library contract for contacts/search and durable private message APIs adapted to native XMPP, game-issued chat admission, history and legacy BW/BW_CHAT2 RPCs"
  }
  Accounts [U,OHS,PL] -> [D,ACL] PlayerSessions {
    implementationTechnology = "Accounts Rust library contract for authentication, opaque account view, garage and equipped vehicle projections with catalog-defined locked outfits, loadout-adjusted mobility, gun performance and equipped armor geometry for battle, plus owned vehicle readiness and temporary module and loadout overlays retaining the saved outfits, ephemeral catalog vehicle projections for connected players and dummies with configurable crew perk efficiency, hit points and ammunition, and revision-checked commands. Sessions orders commands and delivers committed results."
  }
}
BoundedContext GameClient {
  domainVisionStatement = "External versioned World of Tanks executable and resources supply compatibility evidence and garage definitions."
}
BoundedContext ResourceExtraction {
  domainVisionStatement = "Select the installed definitions and component class presence needed by the server and publish a standalone runtime resource bundle."
}
BoundedContext BinaryMapping {
  domainVisionStatement = "Recover supported native type and network framing metadata, retain evidence and unknowns, and emit offline Rust declarations and JSON mappings."
}
BoundedContext Accounts {
  domainVisionStatement = "Own durable identity, password hashes, player roles, dashboard sessions, balances, vehicle ownership, integer preferences, tank/module research, vehicle purchases and sales, installed modules, mounted equipment, consumables and directives, loaded ammunition, shared depot stock and sales, cosmetic ownership and seasonal and common outfits, crew rosters and training, Premium Account expiry, and revisions in PostgreSQL; project snapshots into versioned garage caches."
}
BoundedContext PlayerSessions {
  domainVisionStatement = "Own live player admission, expiring handoff tickets, session lifecycle, garage write coordination, native Store token access, garage-to-arena handoff and delivery of garage, room and chat updates."
}

BoundedContext Battles {
  domainVisionStatement = "Own live arenas, battle IDs, participants, round phases, map and terrain use, vehicle simulation, combat resolution and native battle state replication."
}

BoundedContext Social {
  domainVisionStatement = "Own persistent directed friends and ignored contacts, bounded durable private conversations and retained offline history, legacy window subscriptions, and validated nickname searches over the account directory."
}

BoundedContext PlayerAdministration {
  domainVisionStatement = "Serve player registration, web sign-in, a personal garage view and dashboard Store access, and authorize administrators to provision players, manage roles, inspect garages, launch Training battles with dummies and grant currency, vehicles, cosmetics, crew books, Improved Equipment, Bounty Equipment or Experimental Equipment."
}

BoundedContext Store {
  domainVisionStatement = "Serve the in-game and dashboard storefront, resolve item and currency to a published server offer, validate the quoted price and orchestrate checkout."
}

BoundedContext TrainingRooms {
  domainVisionStatement = "Own hosted Training Room settings, invitations, membership, roster assignment, readiness and room closure between battles."
}

BoundedContext SharedKernel {
  domainVisionStatement = "Maintain the shared meaning and validity rule of a local player account identifier and the performance and seasonal appearance of an equipped battle vehicle."
}

BoundedContext Platform {
  domainVisionStatement = "Supply reusable Mercury transport, tracing adapters and client-format codecs independently of the server's domain models."
}
